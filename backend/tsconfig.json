{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "outDir": "./dist",
        "rootDir": "./src",
        "esModuleInterop": true,
        "allowJs": true,
        "checkJs": false,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "sourceMap": true
    },
    "include": ["src/**/*"]
}
