{
  "name": "gestion-de-equipamiento",
  "version": "1.0.0",
  "description": "sistema de Gestion de equipamiento",
  "type": "module",
  "main": "./dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "NODE_OPTIONS=\"--experimental-loader=@opentelemetry/instrumentation/hook.mjs\" node --import ./dist/instrumentation.js ./dist/app.js",
    "dev": "tsc --watch --preserveWatchOutput & NODE_OPTIONS=\"--experimental-loader=@opentelemetry/instrumentation/hook.mjs\" node --watch --import ./dist/instrumentation.js ./dist/app.js",
    "worker": "NODE_OPTIONS=\"--experimental-loader=@opentelemetry/instrumentation/hook.mjs\" node --watch --import ./dist/instrumentation.js ./dist/workers/notificationWorker.js",
    "worker:start": "NODE_OPTIONS=\"--experimental-loader=@opentelemetry/instrumentation/hook.mjs\" node --import ./dist/instrumentation.js ./dist/workers/notificationWorker.js",
    "init-db": "tsx src/scripts/initDb.ts",
    "init-db:force": "tsx src/scripts/initDb.ts --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "sequelize": "^6.37.8",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "vitest": "^4.1.10"
  }
}
